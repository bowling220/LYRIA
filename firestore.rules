rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function channelMember(channelId) {
      return signedIn()
        && (channelId == 'community'
          || request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members);
    }

    // Off until the owner publishes matching rules/client and enables this policy.
    function limitsEnabled() {
      return exists(/databases/$(database)/documents/systemConfig/freeLimits)
        && get(/databases/$(database)/documents/systemConfig/freeLimits).data.get('enabled', false) == true;
    }
    function shortCap(a) { return a == 'messages' ? 10 : a == 'friends' ? 10 : a in ['channels','articles','reports'] ? 3 : a == 'invites' ? 5 : a == 'profiles' ? 15 : a == 'reactions' ? 30 : 10; }
    function shortSeconds(a) { return a in ['messages','reactions'] ? 10 : 60; }
    function longCap(a) { return a == 'messages' ? 60 : a == 'friends' ? 50 : a == 'channels' ? 15 : a == 'invites' ? 100 : a == 'profiles' ? 500 : a == 'reactions' ? 300 : a == 'articles' ? 20 : a == 'comments' ? 100 : a == 'reports' ? 10 : 200; }
    function longSeconds(a) { return a in ['messages','reactions'] ? 60 : 86400; }
    function stepWindow(start, count, oldStart, oldCount, seconds, cap) {
      return count is int && count > 0 && count <= cap && start is timestamp
        && ((start == oldStart && request.time < oldStart + duration.value(seconds, 's') && count == oldCount + 1)
          || (request.time >= oldStart + duration.value(seconds, 's') && start == request.time && count == 1));
    }
    function rateProof(action, operation) {
      let row = getAfter(/databases/$(database)/documents/usageLimits/$(request.auth.uid)/actions/$(action)).data;
      return row.operation == operation && row.updatedAt == request.time;
    }
    function rateAllowed(action, operation) { return !limitsEnabled() || rateProof(action, operation); }
    function queryBound(maximum) { return !limitsEnabled() || (request.query.limit != null && request.query.limit <= maximum); }
    function textBound(data, key, maximum) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maximum);
    }
    function profileField(key,maximum) {
      return textBound(request.resource.data,key,maximum)
        || (request.method == 'update' && resource.data.get(key,null) == request.resource.data.get(key,null))
        || (request.method == 'create' && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get(key,null) == request.resource.data.get(key,null));
    }
    function profileBounds() {
      return profileField('displayName',120)
        && profileField('bio',2000)
        && profileField('photoURL',400000)
        && profileField('bannerURL',400000)
        && (request.resource.data.get('feedbackSubmissions',[]) is list && request.resource.data.get('feedbackSubmissions',[]).size() <= 50
          || (request.method == 'update' && request.resource.data.get('feedbackSubmissions',[]) == resource.data.get('feedbackSubmissions',[])));
    }
    function messageBounds() {
      return request.resource.data.keys().hasOnly(['message','content','sender','senderId','senderPhotoURL','timestamp','type','gif','mentions','reactions','isCode'])
        && textBound(request.resource.data, 'message', 4000)
        && textBound(request.resource.data, 'content', 4000)
        && textBound(request.resource.data, 'sender', 120)
        && textBound(request.resource.data, 'senderId', 128)
        && textBound(request.resource.data, 'senderPhotoURL', 4096)
        && (!('mentions' in request.resource.data) || (request.resource.data.mentions is list && request.resource.data.mentions.size() <= 50))
        && (!('gif' in request.resource.data) || (request.resource.data.gif is map
          && request.resource.data.gif.keys().hasOnly(['id','provider','providerId','title','url','previewUrl','stillUrl','sourceUrl','width','height'])
          && textBound(request.resource.data.gif,'title',200) && textBound(request.resource.data.gif,'url',4096)
          && textBound(request.resource.data.gif,'previewUrl',4096) && textBound(request.resource.data.gif,'stillUrl',4096)
          && textBound(request.resource.data.gif,'sourceUrl',4096) && textBound(request.resource.data.gif,'id',160)
          && textBound(request.resource.data.gif,'providerId',160) && textBound(request.resource.data.gif,'provider',32)));
    }
    match /systemConfig/freeLimits { allow get: if signedIn(); allow list, write: if false; }
    match /usageLimits/{uid}/actions/{action} {
      allow get: if isSelf(uid); allow list, delete: if false;
      allow create: if isSelf(uid) && action in ['messages','friends','channels','invites','profiles','calls','reactions','articles','comments','reports']
        && request.resource.data.keys().hasOnly(['operation','updatedAt','shortAt','shortCount','longAt','longCount'])
        && request.resource.data.operation is string && request.resource.data.operation.size() <= 200
        && request.resource.data.updatedAt == request.time
        && request.resource.data.shortAt == request.time && request.resource.data.longAt == request.time
        && request.resource.data.shortCount == 1 && request.resource.data.longCount == 1;
      allow update: if isSelf(uid) && action in ['messages','friends','channels','invites','profiles','calls','reactions','articles','comments','reports']
        && request.resource.data.keys().hasOnly(['operation','updatedAt','shortAt','shortCount','longAt','longCount'])
        && request.resource.data.operation is string && request.resource.data.operation.size() <= 200
        && request.resource.data.updatedAt == request.time
        && stepWindow(request.resource.data.shortAt,request.resource.data.shortCount,resource.data.shortAt,resource.data.shortCount,shortSeconds(action),shortCap(action))
        && stepWindow(request.resource.data.longAt,request.resource.data.longCount,resource.data.longAt,resource.data.longCount,longSeconds(action),longCap(action));
    }
    function friendAcceptance(uid) {
      let approval = getAfter(/databases/$(database)/documents/friendshipApprovals/$(uid)/recipients/$(request.auth.uid)).data;
      let before = get(/databases/$(database)/documents/friendRequests/$(approval.requestId)).data;
      let after = getAfter(/databases/$(database)/documents/friendRequests/$(approval.requestId)).data;
      return before.from == uid && before.to == request.auth.uid
        && before.get('status', 'pending') == 'pending'
        && after.status == 'accepted' && after.to == 'accepted_' + uid;
    }
    function friendChange(uid) {
      let old = resource.data.get('friends', []);
      let next = request.resource.data.get('friends', []);
      return signedIn() && next is list && old is list
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends', 'updatedAt'])
        && ((request.auth.uid in old && next == old.removeAll([request.auth.uid]))
          || (next.size() == old.size() + 1 && next.hasAll(old)
            && next.toSet().difference(old.toSet()) == [request.auth.uid].toSet()
            && friendAcceptance(uid)));
    }
    function invitedJoin(channelId) {
      let code = request.resource.data.get('joinInvite', '');
      let invite = get(/databases/$(database)/documents/channelInvites/$(code)).data;
      return !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinInvite'])
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [request.auth.uid].toSet()
        && invite.channelId == channelId && invite.revoked == false
        && (invite.expiresAt == null || invite.expiresAt > request.time);
    }
    function mutualFriends(members) {
      return members.size() == 2 && request.auth.uid in members
        && members[0] != members[1]
        && members[0] in get(/databases/$(database)/documents/users/$(members[1])).data.get('friends', [])
        && members[1] in get(/databases/$(database)/documents/users/$(members[0])).data.get('friends', []);
    }
    match /channelInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && rateAllowed('invites',code) && code.matches('[A-F0-9]{32}')
        && request.resource.data.keys().hasOnly(['channelId','name','createdBy','createdAt','expiresAt','revoked'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.revoked == false
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && (request.resource.data.expiresAt == null || request.resource.data.expiresAt > request.time)
        && get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.createdBy == request.auth.uid
        && channelMember(request.resource.data.channelId);
      allow update: if signedIn() && channelMember(resource.data.channelId)
        && get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
        && request.resource.data.revoked == true;
      allow delete: if false;
    }
    function moderator() {
      let own = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn() && (own.get('role','user') in ['admin','moderator']
        || own.get('badges',[]).hasAny(['admin','Admin','administrator','ADMIN','moderator','Moderator','MODERATOR','Mod','mod','MOD']));
    }
    function contactAllowed(sender,recipient) {
      return !exists(/databases/$(database)/documents/users/$(sender)/blocks/$(recipient))
        && !exists(/databases/$(database)/documents/users/$(recipient)/blocks/$(sender));
    }
    match /users/{uid}/blocks/{other} {
      allow get: if isSelf(uid);
      allow list: if isSelf(uid) && queryBound(100);
      allow create, update: if isSelf(uid) && uid != other && rateAllowed('profiles',uid)
        && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
      allow delete: if isSelf(uid) && rateAllowed('profiles',uid);
    }
    function validReport() {
      let d=request.resource.data;
      return d.keys().hasOnly(['reporterId','targetUserId','channelId','messageId','reason','details','evidenceText','status','createdAt'])
        && d.reporterId == request.auth.uid && d.targetUserId is string && d.targetUserId != request.auth.uid
        && d.targetUserId.size() <= 128 && d.reason in ['spam','harassment','unsafe','other']
        && d.status == 'open' && d.createdAt == request.time
        && textBound(d,'details',1000) && textBound(d,'evidenceText',4000)
        && (('channelId' in d && 'messageId' in d && d.channelId is string && d.messageId is string
          && d.channelId.matches('[A-Za-z0-9_-]{1,180}') && d.messageId.matches('[A-Za-z0-9_-]{1,200}')
          && channelMember(d.channelId)
          && get(/databases/$(database)/documents/channels/$(d.channelId)/messages/$(d.messageId)).data.senderId == d.targetUserId
          && d.evidenceText == get(/databases/$(database)/documents/channels/$(d.channelId)/messages/$(d.messageId)).data.get('message',get(/databases/$(database)/documents/channels/$(d.channelId)/messages/$(d.messageId)).data.get('content','GIF message')))
          || (!('channelId' in d) && !('messageId' in d) && !('evidenceText' in d)
            && exists(/databases/$(database)/documents/profiles/$(d.targetUserId))));
    }
    match /abuseReports/{reportId} {
      allow create: if signedIn() && rateAllowed('reports',reportId) && validReport();
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/abuseReports/$(reportId)) || resource.data.reporterId == request.auth.uid || moderator());
      allow list: if signedIn() && queryBound(30) && (resource.data.reporterId == request.auth.uid || moderator());
      allow update: if moderator() && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.status in ['resolved','dismissed']
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    match /friendshipApprovals/{sender}/recipients/{recipient} {
      allow get: if signedIn() && request.auth.uid in [sender, recipient];
      allow list: if false;
      allow create, update: if isSelf(recipient)
        && request.resource.data.keys().hasOnly(['requestId'])
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.from == sender
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.to == recipient
        && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted';
      allow delete: if false;
    }
    match /profiles/{uid} {
      allow get: if signedIn(); allow list: if signedIn() && queryBound(50);
      allow create, update: if isSelf(uid) && profileBounds() && rateAllowed('profiles',uid)
        && request.resource.data.keys().hasOnly(['displayName','photoURL','avatarGif','bannerURL','bannerGif','bio','status','showBadges','badges','appearance','updatedAt'])
        && request.resource.data.get('badges', []) == getAfter(/databases/$(database)/documents/users/$(uid)).data.get('badges', []);
      allow delete: if isSelf(uid);
    }
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && profileBounds() && request.resource.data.get('badges', []) == []
        && request.resource.data.get('role', 'user') in ['user','guest'];
      allow delete: if isSelf(uid);
      allow update: if (isSelf(uid) && profileBounds() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['badges','role']))
        || friendChange(uid);
    }

    match /users/{uid}/readState/{channelId} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at is number && request.resource.data.at >= 0
        && request.resource.data.at <= request.time.toMillis() + 60000;
    }
    // Parent deletion must leave an immutable tombstone so old messages cannot be
    // claimed by recreating a deleted channel ID. Leaving a conversation is unchanged.
    match /channelTombstones/{channelId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['createdBy','deletedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.deletedAt == request.time
        && get(/databases/$(database)/documents/channels/$(channelId)).data.createdBy == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/channels/$(channelId));
    }
    match /channels/{channelId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/channels/$(channelId)) || channelId == 'community' || channelId == 'personal-' + request.auth.uid || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if channelId != 'community' && signedIn()
        && (channelId == 'personal-' + request.auth.uid || (request.resource.data.get('isDirectCall',false) == true ? rateAllowed('calls',channelId) : rateAllowed('channels',channelId)))
        && textBound(request.resource.data,'name',120)
        && !exists(/databases/$(database)/documents/channelTombstones/$(channelId))
        && (!channelId.matches('personal-.*') || channelId == 'personal-' + request.auth.uid)
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.members == [request.auth.uid]
          || (request.resource.data.get('isDirectCall', false) == true && mutualFriends(request.resource.data.members)));
      allow update: if channelId != 'community' && signedIn()
        && ((request.auth.uid in resource.data.members
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
              && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]))
            || (resource.data.createdBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'activeInvite', 'updatedAt']))))
          || (channelId == 'personal-' + request.auth.uid && resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [request.auth.uid].toSet())
          || invitedJoin(channelId));
      allow delete: if channelId != 'community' && signedIn() && resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/channelTombstones/$(channelId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/channelTombstones/$(channelId)).data.deletedAt == request.time;

      match /messages/{messageId} {
        allow get: if channelMember(channelId);
        allow list: if channelMember(channelId) && queryBound(1000);
        function reactionStep(key) {
          let old = resource.data.get('reactions',{}).get(key,[]);
          let next = request.resource.data.get('reactions',{}).get(key,[]);
          return old is list && next is list
            && ((next.size() == old.size() + 1 && next.hasAll(old)
              && next.toSet().difference(old.toSet()) == [request.auth.uid].toSet())
              || next == old.removeAll([request.auth.uid]));
        }
        function reactionChange() {
          let old = resource.data.get('reactions',{});
          let next = request.resource.data.get('reactions',{});
          return old is map && next is map
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && ((next.diff(old).affectedKeys().hasOnly(['like']) && reactionStep('like'))
              || (next.diff(old).affectedKeys().hasOnly(['heart']) && reactionStep('heart'))
              || (next.diff(old).affectedKeys().hasOnly(['laugh']) && reactionStep('laugh'))
              || (next.diff(old).affectedKeys().hasOnly(['wow']) && reactionStep('wow'))
              || (next.diff(old).affectedKeys().hasOnly(['sad']) && reactionStep('sad'))
              || (next.diff(old).affectedKeys().hasOnly(['celebrate']) && reactionStep('celebrate'))
              || (next.diff(old).affectedKeys().hasOnly(['fire']) && reactionStep('fire'))
              || (next.diff(old).affectedKeys().hasOnly(['eyes']) && reactionStep('eyes')));
        }
        allow create: if channelMember(channelId) && messageBounds() && rateAllowed('messages',messageId)
          && request.resource.data.get('senderId', '') == request.auth.uid
          && request.resource.data.get('reactions',{}) is map && request.resource.data.get('reactions',{}).size() == 0;
        allow update, delete: if channelMember(channelId) && rateAllowed('reactions',messageId)
          && ((request.method == 'delete' && moderator())
            || (resource.data.get('senderId', '') == request.auth.uid
              && (request.method == 'delete' || (messageBounds()
                && request.resource.data.get('senderId','') == request.auth.uid
                && request.resource.data.get('type','') == resource.data.get('type','')
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactions']))))
            || (request.method == 'update' && reactionChange()));
      }

      match /typingStatus/{uid} {
        allow read: if channelMember(channelId);
        allow write: if channelMember(channelId) && isSelf(uid);
      }
    }

    // One active outgoing lifecycle per sender/recipient. Old random request IDs
    // and accepted receipts remain valid; clients never delete or reset the slot.
    match /friendRequestSlots/{sender}/recipients/{recipient} {
      function nextRequest() {
        return getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data;
      }
      function available() {
        return request.method == 'create'
          || !exists(/databases/$(database)/documents/friendRequests/$(resource.data.requestId))
          || get(/databases/$(database)/documents/friendRequests/$(resource.data.requestId)).data.get('status','pending') == 'accepted';
      }
      allow get: if isSelf(sender);
      allow list, delete: if false;
      allow create, update: if isSelf(sender) && sender != recipient
        && request.resource.data.keys().hasOnly(['requestId'])
        && request.resource.data.requestId is string && request.resource.data.requestId.size() <= 200
        && available() && contactAllowed(sender,recipient)
        && nextRequest().from == sender && nextRequest().to == recipient && nextRequest().status == 'pending'
        && (!exists(/databases/$(database)/documents/users/$(sender))
          || !(recipient in getAfter(/databases/$(database)/documents/users/$(sender)).data.get('friends',[])));
    }
    match /friendRequests/{requestId} {
      allow create: if signedIn() && rateAllowed('friends',requestId)
        && getAfter(/databases/$(database)/documents/friendRequestSlots/$(request.auth.uid)/recipients/$(request.resource.data.to)).data.requestId == requestId
        && request.resource.data.keys().hasOnly(['from','to','status','fromName','timestamp'])
        && textBound(request.resource.data,'fromName',120) && textBound(request.resource.data,'to',128)
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid
          || resource.data.to == request.auth.uid
          || resource.data.to == 'accepted_' + request.auth.uid);
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && resource.data.get('status', 'pending') == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['to','status','acceptedByName','acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.to == 'accepted_' + resource.data.from;
      allow delete: if signedIn() && (resource.data.to == request.auth.uid
        || (resource.data.status == 'accepted' && resource.data.to == 'accepted_' + request.auth.uid));
    }

    match /inbox/{messageId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/inbox/$(messageId)) || resource.data.recipientId == request.auth.uid);
      allow create: if signedIn() && rateAllowed('calls',messageId) && request.resource.data.senderId == request.auth.uid
        && (request.resource.data.get('type','') in ['callReply','callCancel'] || contactAllowed(request.auth.uid,request.resource.data.recipientId))
        && textBound(request.resource.data,'message',4000) && textBound(request.resource.data,'recipientId',128);
      allow list, update, delete: if signedIn()
        && resource.data.recipientId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow create: if signedIn() && request.resource.data.userId is string
        && textBound(request.resource.data,'message',4000) && textBound(request.resource.data,'title',160);
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && rateAllowed('reactions',postId)
        && request.resource.data.keys().hasOnly(['likes']) && request.resource.data.likes is number && request.resource.data.likes >= 0 && request.resource.data.likes <= 1000000000;
      allow update: if signedIn() && rateAllowed('reactions',postId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) && request.resource.data.likes is number && request.resource.data.likes >= 0 && request.resource.data.likes <= 1000000000;
      allow delete: if false;
    }

    match /userLikes/{uid}/likes/{postId} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid) && rateAllowed('reactions',postId) && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['liked']) && request.resource.data.liked is bool));
    }

    match /articles/{articleId}/comments/{commentId} {
      allow get: if true; allow list: if queryBound(1000);
      allow create: if signedIn() && rateAllowed('comments',commentId) && request.resource.data.userId == request.auth.uid
        && textBound(request.resource.data,'text',2000) && textBound(request.resource.data,'username',120);
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /userArticles/{articleId} {
      allow get: if true; allow list: if queryBound(100);
      allow create: if signedIn() && rateAllowed('articles',articleId) && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['authorName','authorId','authorPhotoURL','title','body','category','excerpt','imageURL','tags','readingMinutes','timestamp'])
        && textBound(request.resource.data,'authorName',120) && textBound(request.resource.data,'authorPhotoURL',400000)
        && textBound(request.resource.data,'title',160) && textBound(request.resource.data,'body',30000)
        && textBound(request.resource.data,'excerpt',500) && textBound(request.resource.data,'imageURL',4096)
        && (!('tags' in request.resource.data) || (request.resource.data.tags is list && request.resource.data.tags.size() <= 10 && request.resource.data.tags.join(',').size() <= 500));
      allow update, delete: if false;
    }
  }
}
