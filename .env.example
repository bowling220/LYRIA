# All values below are placeholders or local/demo values. No production secrets.
# Node 22.13+/24 reads root .env during npm run build. Never commit .env.
# REQUIRED CHOICE: development (default), preview, or production.
LYRIA_ENV=development

# PUBLIC WEB CLIENT CONFIGURATION: emitted into browser JS, NOT server secrets.
# Development needs no real Firebase account; the built-in demo config uses emulators.
# Hosted preview/production require API_KEY, AUTH_DOMAIN, PROJECT_ID, APP_ID.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Optional public fields, depending on enabled Firebase services:
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
# Required for hosted builds: exact HTTPS origin, no trailing slash. Never production for previews.
LYRIA_SITE_ORIGIN=
# Optional local development override:
LYRIA_EMULATOR_HOST=127.0.0.1

# OPTIONAL PRODUCTION VOICE: configure only in the owner's Render service.
# Browser-scoped TURN credentials-read key becomes public in the built bundle.
# It is NOT Metered's private account-management secretKey. Never use secretKey here.
METERED_APP_NAME=
METERED_TURN_API_KEY=

# PUBLIC MOBILE CONFIGURATION: copy needed EXPO_PUBLIC_* fields to LYRIA/.env.
# A physical phone needs your computer's LAN IP; Android emulator often uses 10.0.2.2.
EXPO_PUBLIC_USE_EMULATORS=true
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-lyria
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-lyria.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-lyria.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:demo

# PRIVATE SERVER CONFIGURATION: none is needed by this vanilla/Firebase client project.
# Do NOT add Firebase service-account JSON, GOOGLE_APPLICATION_CREDENTIALS, GitHub
# tokens, Render deploy hooks, passwords, or admin keys to client config or fork CI.
# Current GIF catalog needs no GIPHY_API_KEY. Historical exposure is documented privately.

# OPTIONAL TEST PROCESS OVERRIDES: export these in the shell (Python does not read .env).
# Defaults use discovered system/Playwright Chromium and coturn executables.
# LYRIA_CHROMIUM=/absolute/path/to/chromium
# LYRIA_TEST_TURN_BINARY=/absolute/path/to/turnserver
